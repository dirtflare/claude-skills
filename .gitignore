# HyperFrames の上流スキル本体 (npx skills add で取得。約19MB / 900ファイル超)
# バージョンを固定せず、常に最新を取り直す方針なのでコミットしない。
# 導入は .claude/skills/hyperframes-jp/scripts/setup.sh が行う。
/.agents/
/agent/
/skills-lock.json

# .claude/skills 配下は自作スキルのみ追跡する。
# setup.sh が張る上流スキルへのシンボリックリンクは対象外。
.claude/skills/*
!.claude/skills/x-post-analysis/
!.claude/skills/hyperframes-jp/
!.claude/skills/generate/

# 動画プロジェクトの生成物
renders/
frames/
node_modules/

# generate スキルの生成物・退避物。実体は絶対にコミットしない。
# (4K 画像や動画が数百 MB 単位で入る。ローカルライブラリはリポジトリの外の資産)
higgsfield-export/
generations/
manifest/
ledger.jsonl

# Python
__pycache__/
*.pyc
